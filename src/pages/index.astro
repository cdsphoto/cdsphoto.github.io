---
import { ClientRouter } from 'astro:transitions';
import site from '../data/site.json';
import { photos } from '../lib/photos.js';

const base = import.meta.env.BASE_URL;
const ogImage = Astro.site
  ? new URL(`${base}assets/og-image.jpg`, Astro.site).href
  : `${base}assets/og-image.jpg`;
const siteUrl = Astro.site ? new URL(base, Astro.site).href : base;
const sameAs = (site.socialLinks || []).map((link) => link.url).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Chahat Singh',
      url: siteUrl,
      description: 'Amateur photographer',
      ...(sameAs.length ? { sameAs } : {}),
      ...(site.location ? { homeLocation: { '@type': 'Place', name: site.location } } : {}),
    },
    {
      '@type': 'WebSite',
      name: site.title,
      url: siteUrl,
      description: site.description,
      author: { '@type': 'Person', name: 'Chahat Singh' },
    },
  ],
};
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const analytics = site.analytics || {};
const instagram = site.socialLinks?.find((link) => link.label === 'Instagram') || site.socialLinks?.[0];
const galleryData = {
  photos,
  base,
  instagramUrl: instagram?.url || '',
  settings: {
    heroInterval: site.heroInterval,
    galleryBatchSize: site.galleryBatchSize,
  },
};
const galleryJson = JSON.stringify(galleryData).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" data-theme="system">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0b0c0e" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
  <meta name="description" content={site.description} />
  <meta name="color-scheme" content="light dark" />
  <title>{site.title}</title>
  <link rel="canonical" href={siteUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={site.title} />
  <meta property="og:description" content={site.description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={site.title} />
  <meta name="twitter:description" content={site.description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/favicon-32.png`} />
  <link rel="icon" type="image/png" sizes="16x16" href={`${base}assets/favicon-16.png`} />
  <link rel="apple-touch-icon" href={`${base}assets/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}manifest.webmanifest`} />
  <meta name="application-name" content={site.brand} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={site.brand} />
  <link rel="stylesheet" href={`${base}assets/vendor/leaflet/leaflet.css`} />
  <link rel="stylesheet" href={`${base}assets/styles.css`} />
  <ClientRouter />
  <script is:inline>
    (function () {
      try {
        const saved = localStorage.getItem('cds-photo-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
        const warmth = localStorage.getItem('cds-photo-warmth');
        if (warmth === 'off') document.documentElement.dataset.warmth = 'off';
      } catch (_) {}
    }());
  </script>
  <script type="application/ld+json" set:html={jsonLdString}></script>
  {analytics.provider === 'cloudflare' && analytics.id && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${analytics.id}"}`}></script>
  )}
  {analytics.provider === 'goatcounter' && analytics.id && (
    <script data-goatcounter={`https://${analytics.id}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>
  )}
</head>
<body>
  <div class="nav-progress" aria-hidden="true"></div>
  <div class="warmth-overlay" aria-hidden="true"></div>
  <a class="skip-link" href="#gallery">Skip to gallery</a>

  <header class="site-header" id="top">
    <a class="brand" href="#featured" aria-label={`${site.title} home`}>
      <span class="brand-mark" aria-hidden="true"></span><span>{site.brand}</span>
    </a>
    <nav class="main-nav" aria-label="Primary navigation"><a href="#gallery">Gallery</a><a href="#map">Locations</a><a href="#about">About</a></nav>
    <div class="header-actions">
      <button class="icon-button warmth-toggle" type="button" aria-label="Toggle warm color grade" title="Toggle warm color grade">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><circle cx="15" cy="7" r="2.2" fill="currentColor" stroke="none"></circle><path d="M4 17h16"></path><circle cx="9" cy="17" r="2.2" fill="currentColor" stroke="none"></circle></svg>
      </button>
      <button class="icon-button theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path></svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 15.7A8.5 8.5 0 0 1 8.3 3.7 8.5 8.5 0 1 0 20.3 15.7Z"></path></svg>
      </button>
    </div>
  </header>

  <section class="hero" id="featured" aria-label="Featured photographs">
    <div class="hero-stage" aria-live="off">
      <div class="hero-frame hero-frame-a is-active" aria-hidden="true"></div>
      <div class="hero-frame hero-frame-b" aria-hidden="true"></div>
      <div class="hero-vignette" aria-hidden="true"></div>
    </div>
    <div class="hero-empty" hidden>
      <div class="hero-empty-inner"><p class="eyebrow">Your portfolio is ready</p><h1>Add photographs to <code>src/photos/</code></h1><p>Then assign tags and featured status in <code>src/data/photos.json</code>.</p></div>
    </div>
    <div class="hero-content">
      <div class="hero-copy">
        <p class="eyebrow">{site.heroEyebrow}</p><h1>{site.heroHeading}</h1>
        <div class="hero-photo-meta" aria-live="polite"><p class="hero-photo-detail"></p><p class="hero-photo-title"></p><div class="hero-photo-tags"></div></div>
      </div>
      <div class="hero-controls" aria-label="Featured slideshow controls">
        <button class="hero-control hero-prev" type="button" aria-label="Previous featured photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6"></path></svg></button>
        <button class="hero-control hero-pause" type="button" aria-label="Pause featured slideshow"><svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg><svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 9 6-9 6Z"></path></svg></button>
        <button class="hero-control hero-next" type="button" aria-label="Next featured photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button>
        <div class="hero-count" aria-live="polite"><span class="hero-current">01</span><span class="hero-divider">/</span><span class="hero-total">01</span></div>
      </div>
    </div>
    <div class="hero-progress" aria-hidden="true"><span></span></div>
    <a class="hero-scroll" href="#gallery" aria-label="Scroll to gallery"><span>Explore</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M7 14l5 5 5-5"></path></svg></a>
  </section>

  <main>
    <section class="gallery-section" id="gallery" aria-labelledby="gallery-title">
      <div class="section-heading"><div><p class="eyebrow">Archive</p><h2 id="gallery-title">The collection</h2></div><p class="gallery-count" aria-live="polite"></p></div>
      <div class="gallery-actions">
        <button class="surprise-trigger" type="button" aria-label="Open a random photograph">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h3.5c1.5 0 2 .5 3 2l5 8c1 1.5 1.5 2 3 2H21"></path><path d="M17 4l4 3-4 3"></path><path d="M3 17h3.5c1.5 0 2-.5 3-2l1.5-2.5"></path><path d="M17 20l4-3-4-3"></path></svg>
          <span>Surprise me</span>
        </button>
      </div>
      <div class="gallery-grid" aria-live="polite"></div>
      <div class="gallery-empty" hidden><p>No photographs yet.</p></div>
      <div class="show-more-wrap" hidden><button class="show-more" type="button">Show more</button></div>
    </section>

    <section class="map-section" id="map" aria-labelledby="map-title">
      <div class="section-heading"><div><p class="eyebrow">Field notes</p><h2 id="map-title">Where these were taken</h2></div></div>
      <div id="location-map" class="location-map" role="img" aria-label="Map showing the locations photographs in this collection were taken"></div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="about-index" aria-hidden="true">01</div>
      <div class="about-copy"><p class="eyebrow">About</p><h2 id="about-title">{site.aboutHeading}</h2>{String(site.aboutText || '').split(/\n\n+/).map((para) => <p>{para}</p>)}</div>
      <div class="about-meta">
        {site.location && <div><span>Based in</span><strong>{site.location}</strong></div>}
        {site.specialties?.length && <div><span>Focus</span><div class="about-specialties">{site.specialties.map((s) => <span class="about-chip">{s}</span>)}</div></div>}
        {site.email && <div><span>Contact</span><a href={`mailto:${site.email}`}>{site.email}</a></div>}
        {site.socialLinks?.length && <div><span>Follow</span><div class="about-links">{site.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}</div></div>}
      </div>
    </section>
  </main>

  <footer class="site-footer"><a class="brand footer-brand" href="#featured"><span class="brand-mark" aria-hidden="true"></span><span>{site.brand}</span></a><p>© <span class="current-year"></span> {site.title}. All photographs reserved.</p><a class="back-to-top" href="#featured">Back to top <span aria-hidden="true">↑</span></a></footer>

  <div class="toast" role="status" aria-live="polite"></div>

  <dialog class="share-dialog" aria-label="Share this photograph">
    <div class="share-dialog-backdrop" data-share-close></div>
    <div class="share-dialog-panel">
      <header class="share-dialog-header">
        <p class="share-dialog-title">Share this photograph</p>
        <button class="icon-button share-dialog-close" type="button" aria-label="Close share dialog" data-share-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg></button>
      </header>
      <div class="share-link-row">
        <input class="share-link-input" type="text" readonly aria-label="Shareable link" />
        <button class="share-copy-btn" type="button">Copy</button>
      </div>
      <div class="share-targets">
        <a class="share-target" data-target="x" href="#" target="_blank" rel="noopener noreferrer">
          <span class="share-target-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-7l-5.5-7.2L4.5 22H1.4l8.1-9.3L.8 2h7.2l5 6.6L18.9 2Zm-1.2 18h1.7L6.4 4H4.6l13.1 16Z"></path></svg></span>
          <span>X</span>
        </a>
        <a class="share-target" data-target="facebook" href="#" target="_blank" rel="noopener noreferrer">
          <span class="share-target-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.3C15.9 4.2 15 4.1 14 4.1c-2.2 0-3.7 1.3-3.7 3.8v2.1H7.7v3h2.6V21h3.2Z"></path></svg></span>
          <span>Facebook</span>
        </a>
        <a class="share-target" data-target="whatsapp" href="#" target="_blank" rel="noopener noreferrer">
          <span class="share-target-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 14.4c-.3-.1-1.6-.8-1.9-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.4.1-.6l.4-.4c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 2 3 4.7 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.6-.7 1.9-1.3.2-.6.2-1.1.2-1.3 0-.1-.2-.2-.5-.3ZM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .9.9-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"></path></svg></span>
          <span>WhatsApp</span>
        </a>
        <a class="share-target" data-target="email" href="#">
          <span class="share-target-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm0 2.4V17h16V7.4l-8 5.3-8-5.3ZM5.2 6l6.8 4.5L18.8 6H5.2Z"></path></svg></span>
          <span>Email</span>
        </a>
      </div>
    </div>
  </dialog>

  <div class="install-prompt" hidden role="dialog" aria-label="Install this app">
    <img class="install-icon" src={`${base}assets/icon-192.png`} alt="" width="46" height="46" />
    <div class="install-text"><strong>Install CDS Photo</strong><span>Add it to your device for a full-screen, app-like experience.</span></div>
    <div class="install-actions">
      <button class="install-accept" type="button" hidden>Install</button>
      <button class="install-dismiss" type="button">Not now</button>
    </div>
  </div>

  <nav class="mobile-tabbar" aria-label="Sections">
    <a class="tab is-active" href="#featured" data-tab="top">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.7V21h14V9.7"></path></svg>
      <span>Home</span>
    </a>
    <a class="tab" href="#gallery" data-tab="gallery">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
      <span>Gallery</span>
    </a>
    <a class="tab" href="#about" data-tab="about">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 20.5c0-4 3.6-6.2 7.5-6.2s7.5 2.2 7.5 6.2"></path></svg>
      <span>About</span>
    </a>
  </nav>

  <dialog class="lightbox" aria-label="Photograph viewer">
    <div class="lightbox-backdrop" data-lightbox-close></div>
    <div class="lightbox-shell">
      <header class="lightbox-header"><div class="lightbox-counter" aria-live="polite"></div><div class="lightbox-header-actions"><button class="icon-button lightbox-share" type="button" aria-label="Share this photograph"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 10.5 15.4 6.8M8.6 13.5l6.8 3.7"></path></svg></button><button class="icon-button lightbox-close" type="button" aria-label="Close photograph viewer" data-lightbox-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg></button></div></header>
      <div class="lightbox-media"><button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous photograph"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6"></path></svg></button><img class="lightbox-image" src="" alt="" /><button class="lightbox-nav lightbox-next" type="button" aria-label="Next photograph"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div>
      <footer class="lightbox-caption"><div class="lightbox-caption-main"><p class="lightbox-title"></p><p class="lightbox-description"></p><p class="lightbox-detail"></p><p class="lightbox-technical"></p></div><div class="lightbox-caption-side"><div class="lightbox-tags"></div><a class="lightbox-inquiry" href="#" target="_blank" rel="noopener" hidden>Request this print</a></div></footer>
    </div>
  </dialog>

  <script is:inline set:html={`window.CDS_PHOTO_DATA = ${galleryJson};`}></script>
  <script is:inline src={`${base}assets/vendor/leaflet/leaflet.js`}></script>
  <script is:inline src={`${base}assets/app.js`}></script>
  <script is:inline src={`${base}assets/pwa.js`}></script>
</body>
</html>
