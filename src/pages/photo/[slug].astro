---
import site from '../../data/site.json';
import { photos } from '../../lib/photos.js';

export function getStaticPaths() {
  return photos.map((photo) => ({
    params: { slug: photo.slug },
    props: { photo },
  }));
}

const { photo } = Astro.props;
const base = import.meta.env.BASE_URL;
const description = photo.description || site.description;
const galleryUrl = `${base}?photo=${encodeURIComponent(photo.path)}`;
const canonicalUrl = Astro.site ? new URL(`${base}photo/${photo.slug}/`, Astro.site).href : `${base}photo/${photo.slug}/`;
const ogImageUrl = Astro.site ? new URL(photo.ogImageSrc, Astro.site).href : photo.ogImageSrc;
const contentUrl = Astro.site ? new URL(photo.originalSrc, Astro.site).href : photo.originalSrc;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: photo.title,
  description,
  contentUrl,
  thumbnailUrl: ogImageUrl,
  url: canonicalUrl,
  ...(photo.width ? { width: photo.width } : {}),
  ...(photo.height ? { height: photo.height } : {}),
  creator: { '@type': 'Person', name: 'Chahat Singh' },
  creditText: 'Chahat Singh',
  copyrightNotice: 'Chahat Singh',
  ...(photo.year ? { datePublished: String(photo.year) } : {}),
  ...(photo.location ? { contentLocation: { '@type': 'Place', name: photo.location } } : {}),
};
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{photo.title} — {site.title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={photo.title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={site.title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={photo.title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/favicon-32.png`} />
  <script type="application/ld+json" set:html={jsonLdString}></script>

  <!--
    No analytics beacon on this page: it redirects in well under the time an
    async/deferred script needs to load and fire, so a beacon here would
    rarely get a chance to record anything. The homepage's beacon records
    the visit instead, once the redirect below lands there with ?photo=
    still in the URL.
  -->
  <!--
    This page exists purely so link-preview crawlers (which fetch plain HTML
    and never run JavaScript) see this exact photo's own title/description/
    image in the Open Graph tags above, instead of the whole site's generic
    card. Real visitors get redirected straight into the interactive gallery
    with this photo already open in the viewer.
  -->
  <meta http-equiv="refresh" content={`0; url=${galleryUrl}`} />
  <script is:inline define:vars={{ galleryUrl }}>
    window.location.replace(galleryUrl);
  </script>
</head>
<body>
  <p>Opening <a href={galleryUrl}>{photo.title}</a>…</p>
</body>
</html>
